# Build context for the runtime image. Data and run outputs are mounted at run time, never baked.

# secrets
.env
.env.*
!.env.example

# data: BIRD (~4 GB), the generated SaaS database, catalogs and indexes live on a volume
data/

# run outputs; the committed spend ledger stays so the lifetime cap holds without a mount
runs/*
!runs/spend_ledger.jsonl

# the local response-cache store; the image ships the committed shards and imports them on first use
cache/llm/responses.sqlite*

# environments and tool caches
.venv/
**/__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage*
coverage.xml
htmlcov/
dist/
build/

# not needed at run time
.git/
.github/
tests/
docs/
scripts/
Dockerfile
.dockerignore
.pre-commit-config.yaml
