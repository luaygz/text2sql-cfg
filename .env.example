# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...

# Models (see docs/adr/001-openai-cfg.md)
GENERATOR_MODEL=gpt-6.1-sol
SMALL_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
SERVICE_TIER=flex

# Budget: per-run abort threshold and lifetime cap across the spend ledger
MAX_SPEND_USD=30
TOTAL_SPEND_CAP_USD=50

# Replay from the committed response cache without calling the API
OFFLINE=false
